{
  "name": "murmur-core-engine",
  "version": "1.0.0",
  "description": "Stable, deterministic agent-loop with learning and rollback",
  "main": "dist/agent/runAgent.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/agent/runAgent.js",
    "test": "jest --forceExit",
    "test:unit": "jest --testPathPattern=unit --forceExit",
    "test:property": "jest --testPathPattern=property --forceExit",
    "test:replay": "jest --testPathPattern=replay --forceExit",
    "test:chaos": "jest --testPathPattern=chaos --forceExit",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' 'tests/**/*.ts' --fix"
  },
  "dependencies": {
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.ts"
    ]
  }
}
